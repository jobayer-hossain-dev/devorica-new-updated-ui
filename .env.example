# ==========================================
# DEVORICA MAILING SYSTEM CONFIGURATION
# ==========================================
# Configured for Devorica Outgoing Mail Server (Secure SSL/TLS)

# 1. Outgoing Server Host
SMTP_HOST=mail.devorica.com

# 2. SMTP Port (465 for Secure SSL/TLS)
SMTP_PORT=465

# 3. Secure Connection
SMTP_SECURE=true

# 4. Username / Account
SMTP_USER=support@devorica.com

# 5. Account Password (Set your email password here)
SMTP_PASS=your_email_account_password

# 6. Sender Identity
SMTP_FROM_EMAIL=support@devorica.com
SMTP_FROM_NAME=Devorica AI Product Studio

# 7. Admin Notification Recipient
ADMIN_NOTIFICATION_EMAIL=support@devorica.com
