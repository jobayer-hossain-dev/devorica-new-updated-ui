# ==========================================
# DEVORICA MAILING SYSTEM CONFIGURATION
# ==========================================
# When you have your SMTP credentials, create a .env file in the root
# or add these variables to your Vercel Project Settings > Environment Variables.

# 1. SMTP Server Host
# Examples:
# Gmail: smtp.gmail.com
# Zoho Mail: smtppro.zoho.com (or smtp.zoho.com)
# Hostinger/cPanel: mail.yourdomain.com
# Resend: smtp.resend.com
# SendGrid: smtp.sendgrid.net
# Amazon SES: email-smtp.us-east-1.amazonaws.com
SMTP_HOST=smtp.gmail.com

# 2. SMTP Server Port
# 465 for SSL/TLS (recommended)
# 587 for STARTTLS
SMTP_PORT=465

# 3. Secure Connection (true for port 465, false for port 587)
SMTP_SECURE=true

# 4. SMTP Authentication User (your full email address or username)
SMTP_USER=contact@devorica.com

# 5. SMTP Authentication Password
# For Gmail: Use an App Password (Google Account > Security > 2-Step Verification > App passwords)
# For Zoho/cPanel: Your mailbox password or app-specific password
SMTP_PASS=your_app_password_here

# 6. Sender Identity
SMTP_FROM_EMAIL=contact@devorica.com
SMTP_FROM_NAME=Devorica AI Product Studio

# 7. Admin Notification Recipient (where incoming lead alerts should be delivered)
ADMIN_NOTIFICATION_EMAIL=contact@devorica.com
